# ---------------------------------------------------------------------------
# Credentials index for the whole repo.
#
# Nothing loads a .env at the repo root -- each component reads its own file.
# This is the single place that lists every credential the project uses, where
# it belongs, and where to get it. Copy the relevant block into the file named
# in its heading.
#
# Every real .env is gitignored. Only *.env.example files are ever committed.
# ---------------------------------------------------------------------------


# === backend/.env ==========================================================
# Read by app/__init__.py via python-dotenv. Local dev only -- on AWS these
# come from the Lambda environment, set by Terraform (see infra/variables.tf).

# Flask session signing key. Any non-empty string locally.
SECRET_KEY=change-me

# Origin allowed by flask-cors. The Vite dev server runs on 5173.
# CORS is handled entirely in Flask, never on API Gateway -- see infra/README.md.
CORS_ORIGINS=http://localhost:5173

# Used only when an auditor explicitly requests structured Investigator/Skeptic
# analysis for a FireEvent. Lambda authenticates to Bedrock with its IAM role;
# no Anthropic API key belongs here. The Claude 5 family is NOT entitled for
# this AWS account -- Converse returns AccessDenied -- so this names Haiku 4.5,
# which is both entitled and the fastest option (see docs/decision-log.md).
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0


# === frontend/.env =========================================================
# Read by Vite at build time. Only VITE_-prefixed names reach the browser --
# and they are baked into the bundle, so never put a secret here.

# Base URL of the API. Leave unset for local dev and for any deployment that
# serves the console from the same origin as the API: the Vite dev server
# proxies /api to 127.0.0.1:5001, and a same-origin deployment needs no
# prefix. Set it only when the console is hosted apart from the API, e.g.
# VITE_API_BASE_URL=https://xxxx.execute-api.ap-southeast-1.amazonaws.com
VITE_API_BASE_URL=

# Carto basemap tiles (the scoped audit map's dark_all raster layer) now
# require a key on every request. Free account, generate a key under
# Developers -> API Keys: https://app.carto.com
# This is a client-side, domain-restrictable key by design -- unlike the
# other frontend vars, it is meant to ship in the built bundle. Restrict it
# to this app's origin(s) in the Carto dashboard once one exists; leave
# blank and the map falls back to the (currently rate-limited/unreliable)
# unauthenticated request.
VITE_CARTO_API_KEY=

# NASA FIRMS MAP_KEY, used by the landing page's live regional hotspot layer
# (AuditLanding.tsx fetches firms.modaps.eosdis.nasa.gov directly from the
# browser). Same key as NASA_FIRMS_MAP_KEY below; free signup at
# https://firms.modaps.eosdis.nasa.gov/api/. Leave blank and the landing page
# still renders -- the live layer reports itself unavailable rather than
# inventing detections.
#
# CAUTION: unlike the Carto key this one is NOT domain-restrictable, and Vite
# bakes it into the public bundle, so anyone can read and spend its rate
# limit. Acceptable for a demo on a free key; proxy it through the API before
# any deployment that matters.
VITE_FIRMS_MAP_KEY=


# === data_pipeline/.env ====================================================
# Read by data_pipeline/config.py. Needed only to run the feasibility spike;
# no CI job uses these.

# NASA FIRMS thermal hotspots. Free MAP_KEY by email signup:
# https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=

# Copernicus Data Space Ecosystem -- https://dataspace.copernicus.eu
# Free account. Required only to DOWNLOAD Sentinel products; the STAC
# catalogue search the spike uses works unauthenticated, so these can stay
# blank until imagery download is actually needed.
CDSE_USERNAME=
CDSE_PASSWORD=

# Not yet wired -- placeholder modules live in data_pipeline/sources/future/.
# Global Forest Watch Data API -- https://data-api.globalforestwatch.org/
GFW_API_KEY=
# BMKG (Indonesian meteorology agency) -- data.bmkg.go.id
BMKG_API_KEY=


# === GitHub -> Settings -> Secrets and variables -> Actions ================
# What the deploy pipeline (.github/workflows/infra.yml) reads. These are NOT
# put in any .env file.
#
# There are deliberately NO AWS credentials here. GitHub authenticates to AWS
# over OIDC and assumes an IAM role, so there is no access key to leak or
# rotate. Never add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to this repo.
#
#   Repository VARIABLE   AWS_ROLE_ARN    (required — already set)
#     The role GitHub assumes. Created by infra/bootstrap/:
#       cd infra/bootstrap && terraform output -raw github_actions_role_arn
#     Currently: arn:aws:iam::<account-id>:role/vibe-for-good-2026-github-actions
#
#   Repository VARIABLE   CORS_ORIGINS    (optional — defaults to "*")
#     Origin the deployed console is served from. Set this once the frontend
#     has a real URL; until then "*" is fine for a dev stack.
#
#   Repository SECRET     FLASK_SECRET_KEY  (optional — defaults to "dev")
#     Becomes the Lambda's SECRET_KEY. NOTE: Terraform stores it in state in
#     plain text, so treat it as a placeholder until it moves to AWS Secrets
#     Manager (see "Not built yet" in infra/README.md).
#
# Set them from the CLI with:
#   gh variable set AWS_ROLE_ARN --body "<role arn>"
#   gh variable set CORS_ORIGINS --body "https://..."
#   gh secret   set FLASK_SECRET_KEY
